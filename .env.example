# Same-origin API mode is the production default. Set a URL only for split local development.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Explicit opt-in for the seeded browser-only demo; never enable this in production.
NEXT_PUBLIC_DEMO_MODE=false

OFFICE_DATABASE_PATH=backend/data/office.sqlite3
OFFICE_AUTH_REQUIRED=false
OFFICE_RATE_LIMIT_PER_MINUTE=240
